# Virtual environment: rebuilt from requirements.txt, not tracked.
.venv/
__pycache__/
*.py[cod]

# macOS
.DS_Store

# Raw downloadable data: reconstructed by scripts/00_download_data.py, with
# integrity guaranteed by 01_Target/MANIFEST.json, which IS tracked. Keeping
# these in git would inflate the repository without adding anything.
01_Target/human/*.fasta
01_Target/human/*.json
01_Target/mouse/*.fasta
01_Target/mouse/*.json
01_Target/structure/*.pdb
01_Target/structure/*.cif

# Heavy model outputs. A predicted structure that backs a reported number is
# tracked; the raw trajectory output that produced it is not.
03_Design/**/*.pdb
03_Design/**/*.cif
03_Design/**/*.npz
03_Design/**/*.pkl

# The trimmed target is small and is the exact input to every design run,
# so it is tracked despite the rule above. Reproducing a campaign needs the
# same coordinates, not just the script that produced them.
!03_Design/target/*.pdb

# The eight accepted binders and the re-predicted variant complexes. These
# are the coordinates behind every interface figure in docs/validation.md,
# and a reader cannot check those numbers without them. 6 MB in total.
!03_Design/accepted/*.pdb
!03_Design/validation/predictions/*.pdb

# Credentials. Never.
.env
*.key

# Raw BindCraft run output: 213 MB of trajectories, reproducible from the
# Kaggle notebook. What came out of them is tracked — the accepted designs,
# the per-run logs, and the rejection analysis that distils them.
03_Design/run1/
03_Design/run2/
